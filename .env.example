# Copier vers .env et adapter. Le .env n'est jamais versionné.

SECRET_KEY=remplacer-par-une-cle-generee
DEBUG=True
# `.share.zrok.io` (point initial) = joker : autorise tout tunnel zrok, dont le
# sous-domaine change à chaque `zrok share`. CORS/CSRF pour les origines zrok
# sont gérés par regex dans settings.py, pas ici.
ALLOWED_HOSTS=localhost,127.0.0.1,.share.zrok.io
CORS_ALLOWED_ORIGINS=http://localhost:3000
# En production : le(s) domaine(s) de l'API lui-même, pour que /admin/
# (authentification par session) accepte les connexions. Vide par défaut,
# inutile en dev (l'API n'a pas besoin d'être trustée pour elle-même en HTTP).
CSRF_TRUSTED_ORIGINS=

# PostgreSQL — champ par champ (plutôt qu'une DATABASE_URL) pour ne jamais
# avoir à pourcent-encoder un mot de passe contenant des caractères spéciaux
# d'URL (@ { } * , = ...). DB_HOST/DB_PORT ont un défaut (127.0.0.1/5432),
# DB_NAME/DB_USER/DB_PASSWORD sont obligatoires.
DB_NAME=oils_stock
DB_USER=oils_stock
DB_PASSWORD=motdepasse
DB_HOST=127.0.0.1
DB_PORT=5432

# Fuseau horaire de l'entrepôt (ex. Africa/Abidjan). Par défaut UTC.
TIME_ZONE=UTC

# E-mail (réinitialisation de mot de passe). Si non renseigné, les e-mails
# sont juste affichés dans la console (EMAIL_BACKEND par défaut) — aucun
# compte SMTP requis pour développer. Pour un vrai envoi via Gmail : activer
# la validation en 2 étapes puis générer un « mot de passe d'application »
# (https://myaccount.google.com/apppasswords) — ne jamais utiliser le mot de
# passe du compte lui-même.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=remplacer-par-l-adresse-expeditrice@gmail.com
EMAIL_HOST_PASSWORD="mot-de-passe-d-application-16-caracteres"
DEFAULT_FROM_EMAIL="Oils of Africa Stock <remplacer-par-l-adresse-expeditrice@gmail.com>"

# Web push (notifications navigateur). Générer une paire de clés VAPID :
#   cd ../oils-stock-web && npx web-push generate-vapid-keys
# Coller la clé publique et la clé privée ci-dessous (base64 URL-safe, telles
# quelles). Sans elles, seules les notifications in-app fonctionnent : l'envoi
# web push est ignoré (simple warning au log), rien ne casse.
# VAPID_CLAIM_EMAIL : un mailto: de contact de l'exploitant.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:remplacer-par-l-adresse-de-contact@example.com
