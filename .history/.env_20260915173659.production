# Configuration de PRODUCTION — à copier vers `.env` sur le serveur
# (hébergement mutualisé/cPanel, déploiement Passenger). NE JAMAIS committer
# ce fichier ni le renommer `.env` en local : il pointe sur la vraie base de
# données de production.

# Générée spécifiquement pour la prod — jamais la même clé qu'en dev (si la
# clé de dev fuitait un jour, les sessions/jetons de prod ne doivent pas être
# compromis pour autant).
SECRET_KEY=0a&d%f#+y_22_f3!92t$1czelb&0l9l9@_9k9qj630ssiqo36k

# Toujours False en production — DEBUG=True expose la stack trace complète
# (dont des extraits de settings/variables locales) à quiconque déclenche une
# erreur serveur, en clair sur le site public.
DEBUG=False

ALLOWED_HOSTS = [
    "oils-stock-api.communaute-tepo.com",
    "localhost",
    "127.0.0.1",
]
# Origine du frontend de production — schéma HTTPS supposé (AutoSSL/Let's
# Encrypt quasi systématique sur ce type d'hébergement). À corriger si le
# frontend n'est pas encore servi en HTTPS.
CORS_ALLOWED_ORIGINS=https://approv2.empotage-oils-of-africa.net

# Nécessaire pour que /admin/ (auth par session, pas par JWT) accepte les
# connexions sur le domaine réel de l'API en production.
CSRF_TRUSTED_ORIGINS=https://oils-stock-api.communaute-tepo.com

# PostgreSQL — host/port confirmés par l'utilisateur (localhost:5432, la base
# tourne sur le même serveur que l'application). Mot de passe encodé en
# pourcent-encodage URL (contient @ { } * , = — voir la note ci-dessous).
DATABASE_URL=postgres://c2805526c_user:~%21%7BM%2A%2Cf%3DO%40x4IRs%7B@localhost:5432/c2805526c_oils-stock

TIME_ZONE=UTC

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ibrahimkabore025@gmail.com
EMAIL_HOST_PASSWORD="hrwc jlvv ksqy gfeq"
DEFAULT_FROM_EMAIL="Oils of Africa Stock <ibrahimkabore025@gmail.com>"

